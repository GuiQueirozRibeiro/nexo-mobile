# ==============================================================================
# NEXO MOBILE (REACT NATIVE + EXPO) — VARIÁVEIS DE AMBIENTE
# ==============================================================================
# ATENÇÃO: NUNCA insira chaves reais neste arquivo. Copie para .env.local.
# O app mobile consome o site oficial como API BFF (zero chaves Asaas/Pluggy no app).

EXPO_PUBLIC_NEXO_API_URL=https://nexo.eximiatech.com.br
EXPO_PUBLIC_APP_FLAVOR=PROD

# Firebase Auth & Cloud Firestore (Apenas placeholders no .env.example)
NEXT_PUBLIC_FIREBASE_API_KEY=sua_firebase_api_key_aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
