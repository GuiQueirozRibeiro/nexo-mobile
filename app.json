{
  "expo": {
    "name": "Nexo Finance",
    "slug": "nexo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0c0e"
    },
    "scheme": "nexo",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.eximiatech.nexo",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Autorize transferências PIX instantâneas e desbloqueio do app com Face ID no Nexo Finance.",
        "NSCameraUsageDescription": "O Nexo Finance utiliza a câmera exclusivamente para validação de documentos oficiais e prova de vida facial (KYC)."
      }
    },
    "android": {
      "package": "br.com.eximiatech.nexo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0c0e"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "VIBRATE"
      ]
    },
    "owner": "guiqueirozribeiro",
    "extra": {
      "eas": {
        "projectId": "0181d43a-5f59-4c73-90ca-9db10cde7b8a"
      }
    }
  }
}
